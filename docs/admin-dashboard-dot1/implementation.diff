+ it('does not turn read denied/error into empty public result',()=>{const s=source();s.guest.ko={kind:'denied'};s.guest.en={kind:'error'};const c=snapshot('products','1','P',s,false).cells;expect(c[0].publicLabel).toContain('Bị từ chối');expect(c[1].publicLabel).toContain('Chưa xác định');expect(c[0].instruction).toContain('editor/admin')})
